generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  BLOCKED
  INACTIVE
}

model User {
  id        String   @id @default(uuid())
  name      String   @unique
  password  String
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())

  @@map("users")
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("categories")
}
